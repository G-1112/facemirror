.poster-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.poster-canvas {
  width: 600rpx;
  height: 800rpx;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}
.save-btn {
  margin-top: 20rpx;
  background: #2563eb;
  color: #fff;
  font-size: 28rpx;
  border-radius: 16rpx;
  width: 400rpx;
}
