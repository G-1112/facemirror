.note {
  background: #fef2f2;
  border-left: 6rpx solid #ef4444;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
}
.note-sentence {
  font-size: 26rpx;
  color: #1f2937;
  margin-bottom: 12rpx;
}
.note-row {
  font-size: 24rpx;
  color: #4b5563;
  line-height: 1.6;
}
.note-tag {
  display: inline-block;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  font-size: 20rpx;
  margin-right: 10rpx;
}
.note-tag.issue {
  background: #fee2e2;
  color: #dc2626;
}
.note-tag.sug {
  background: #dbeafe;
  color: #2563eb;
}
