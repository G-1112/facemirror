.empty {
  text-align: center;
  padding: 120rpx 0;
  color: #9ca3af;
}
.empty-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.history-item {
  border-left: 6rpx solid #2563eb;
}
.history-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.history-scene {
  font-size: 24rpx;
  color: #2563eb;
  font-weight: 600;
}
.history-score {
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2937;
}
.history-question {
  font-size: 28rpx;
  color: #4b5563;
  margin: 12rpx 0 8rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.history-date {
  font-size: 22rpx;
  color: #9ca3af;
}

.load-more {
  text-align: center;
  padding: 20rpx 0;
}
