.empty {
  text-align: center;
  padding: 120rpx 0;
  color: #9ca3af;
}
.empty-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.history-item {
  border-left: 6rpx solid #2563eb;
}
.history-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.history-scene {
  font-size: 24rpx;
  color: #2563eb;
  font-weight: 600;
}
.history-score {
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2937;
}
.history-question {
  font-size: 28rpx;
  color: #4b5563;
  margin: 12rpx 0 8rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.history-date {
  font-size: 22rpx;
  color: #9ca3af;
}

.load-more {
  text-align: center;
  padding: 20rpx 0;
}

/* 加载失败重试按钮（新增） */
.retry-load-btn {
  margin-top: 32rpx;
  width: 320rpx;
  font-size: 28rpx;
  line-height: 2.4;
}

/* ---- 练习趋势面板 ---- */
.trend-panel {
  background: linear-gradient(135deg, #eff6ff 0%, #f8fafc 100%);
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(37, 99, 235, 0.08);
}
.trend-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 20rpx;
}
.trend-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1e3a8a;
}
.trend-sub {
  font-size: 22rpx;
  color: #64748b;
}
.trend-metrics {
  display: flex;
  justify-content: space-around;
  margin-bottom: 24rpx;
}
.metric {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.metric-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #1d4ed8;
  line-height: 1.2;
}
.metric-num.up {
  color: #dc2626; /* 分数上升用红色（中国习惯） */
}
.metric-num.down {
  color: #16a34a;
}
.metric-label {
  font-size: 22rpx;
  color: #6b7280;
  margin-top: 4rpx;
}

.spark {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  height: 160rpx;
  padding: 0 8rpx;
  margin-bottom: 24rpx;
  border-bottom: 2rpx solid #cbd5e1;
}
.spark-bar {
  flex: 1;
  margin: 0 4rpx;
  min-height: 8rpx;
  background: linear-gradient(180deg, #60a5fa 0%, #2563eb 100%);
  border-radius: 6rpx 6rpx 0 0;
  display: flex;
  justify-content: center;
  align-items: flex-start;
}
.spark-val {
  font-size: 18rpx;
  color: #334155;
  transform: translateY(-4rpx);
}

.dims {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.dim-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.dim-label {
  font-size: 22rpx;
  color: #475569;
  width: 88rpx;
  flex-shrink: 0;
}
.dim-track {
  flex: 1;
  height: 14rpx;
  background: #e2e8f0;
  border-radius: 7rpx;
  overflow: hidden;
}
.dim-fill {
  height: 100%;
  background: linear-gradient(90deg, #60a5fa, #2563eb);
  border-radius: 7rpx;
  transition: width 0.4s ease;
}
.dim-val {
  font-size: 22rpx;
  color: #1e40af;
  width: 48rpx;
  text-align: right;
  flex-shrink: 0;
}

/* ---- 场景筛选（第三轮交互增强） ---- */
.scene-tabs {
  display: flex;
  gap: 12rpx;
  margin-bottom: 20rpx;
}
.scene-tab {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: #475569;
  background: #fff;
  border: 2rpx solid #e2e8f0;
  border-radius: 999rpx;
  padding: 12rpx 0;
}
.scene-tab.active {
  color: #fff;
  background: #2563eb;
  border-color: #2563eb;
  font-weight: 600;
}
