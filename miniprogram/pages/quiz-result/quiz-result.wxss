.page {
  padding: 30rpx 30rpx 80rpx;
}

.loading {
  padding: 120rpx 40rpx;
  text-align: center;
}

.loading-txt {
  font-size: 28rpx;
  color: #6b7280;
}

.err-box {
  margin-top: 60rpx;
  padding: 40rpx;
  background: #fef2f2;
  border-radius: 16rpx;
}

.err-txt {
  font-size: 28rpx;
  color: #b91c1c;
  line-height: 1.6;
  margin-bottom: 30rpx;
}

.retry-btn {
  width: 60%;
  margin-bottom: 20rpx;
}

.home-btn {
  width: 60%;
}

.card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2937;
  margin-bottom: 20rpx;
}

/* 总分 */
.score-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.score-num {
  font-size: 88rpx;
  font-weight: 800;
  color: #2563eb;
  line-height: 1;
}

.score-label {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2937;
}

.score-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #6b7280;
}

.persist-warn,
.inject-warn {
  margin-top: 20rpx;
  padding: 16rpx 20rpx;
  background: #fffbeb;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #b45309;
  line-height: 1.5;
}

.inject-warn {
  background: #fef2f2;
  color: #b91c1c;
}

.radar-note {
  margin-top: 12rpx;
  text-align: center;
  font-size: 22rpx;
  color: #9ca3af;
}

/* 分科目条形 */
.dim {
  margin-bottom: 26rpx;
}

.dim-line {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.dim-name {
  font-size: 27rpx;
  color: #374151;
  font-weight: 500;
}

.dim-score {
  font-size: 26rpx;
  color: #2563eb;
  font-weight: 600;
}

.dim-bar {
  margin-top: 10rpx;
  height: 14rpx;
  background: #e5e7eb;
  border-radius: 999rpx;
  overflow: hidden;
}

.dim-fill {
  height: 100%;
  background: #2563eb;
  border-radius: 999rpx;
}

.dim-summary {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #6b7280;
  line-height: 1.5;
}

.para {
  font-size: 28rpx;
  color: #374151;
  line-height: 1.7;
}

/* 建议 */
.sug {
  display: flex;
  margin-bottom: 16rpx;
}

.sug-dot {
  color: #2563eb;
  margin-right: 12rpx;
  font-weight: 700;
}

.sug-txt {
  flex: 1;
  font-size: 27rpx;
  color: #374151;
  line-height: 1.6;
}

/* 逐题点评 */
.pq {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f3f4f6;
}

.pq:last-child {
  border-bottom: none;
}

.pq-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.pq-no {
  font-size: 24rpx;
  color: #6b7280;
}

.pq-score {
  font-size: 26rpx;
  font-weight: 700;
}

.s-1, .s-2 {
  color: #b91c1c;
}

.s-3 {
  color: #b45309;
}

.s-4, .s-5 {
  color: #059669;
}

.pq-question {
  margin-top: 10rpx;
  font-size: 28rpx;
  color: #1f2937;
  line-height: 1.6;
  font-weight: 500;
}

.pq-comment {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #6b7280;
  line-height: 1.6;
}

.pq-unanswered {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #9ca3af;
}

.again-btn {
  margin-top: 10rpx;
}

/* ---- 分享海报弹层（2026-11-17 接线，样式与 pages/result 同口径）---- */
.action-row {
  margin-top: 24rpx;
}
.action-row .btn-primary {
  width: 100%;
}
.poster-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
}
.poster-modal {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.close-btn {
  margin-top: 20rpx;
  color: #fff;
  font-size: 28rpx;
}
