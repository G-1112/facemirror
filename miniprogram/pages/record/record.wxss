.question-card {
  border-left: 8rpx solid #2563eb;
}
.q-label {
  font-size: 24rpx;
  color: #2563eb;
  font-weight: 600;
}
.q-text {
  font-size: 32rpx;
  line-height: 1.6;
  margin-top: 8rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  margin: 24rpx 0 16rpx;
  color: #374151;
}

.duration-row {
  display: flex;
  gap: 16rpx;
}
.duration-chip {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  background: #fff;
  border-radius: 12rpx;
  border: 3rpx solid transparent;
  font-size: 28rpx;
}
.duration-chip.active {
  border-color: #2563eb;
  background: #eff6ff;
  color: #2563eb;
  font-weight: 600;
}

.record-area {
  text-align: center;
  padding: 40rpx 0;
}
.countdown {
  font-size: 72rpx;
  font-weight: 700;
  color: #1f2937;
  margin-bottom: 24rpx;
}
.record-btn {
  display: inline-block;
  padding: 32rpx 64rpx;
  border-radius: 999rpx;
  background: #2563eb;
  color: #fff;
  font-size: 34rpx;
  font-weight: 600;
}
.record-btn.recording {
  background: #dc2626;
  animation: pulse 1.5s infinite;
}
@keyframes pulse {
  0% { transform: scale(1); }
  50% { transform: scale(1.05); }
  100% { transform: scale(1); }
}
.stop-btn {
  margin-top: 32rpx;
}

.processing {
  text-align: center;
  padding: 48rpx 24rpx;
}
.processing-text {
  font-size: 32rpx;
  font-weight: 600;
}

.transcript-editor {
  width: 100%;
  min-height: 300rpx;
  background: #f8fafc;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  margin-bottom: 20rpx;
}
