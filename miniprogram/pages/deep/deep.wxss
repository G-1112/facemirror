/* 深度面试 · 逐题作答页 */

.page {
  padding: 24rpx;
  padding-bottom: 60rpx;
}

.loading {
  padding: 120rpx 0;
  text-align: center;
}
.loading-txt {
  font-size: 28rpx;
  color: #9ca3af;
}

.err-box {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 40rpx 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.err-txt {
  font-size: 28rpx;
  color: #991b1b;
  line-height: 1.6;
  margin-bottom: 24rpx;
}
.err-inline {
  font-size: 24rpx;
  color: #dc2626;
  line-height: 1.6;
  margin-top: 16rpx;
}

/* ---- 进度 ---- */
.progress {
  margin-bottom: 24rpx;
}
.progress-bar {
  height: 10rpx;
  background: #e5e7eb;
  border-radius: 999rpx;
  overflow: hidden;
}
.progress-fill {
  height: 10rpx;
  background: #2563eb;
  border-radius: 999rpx;
  transition: width 0.25s ease;
}
.progress-txt {
  display: flex;
  justify-content: space-between;
  font-size: 23rpx;
  color: #6b7280;
  margin-top: 10rpx;
}

/* ---- 题目 ---- */
.q-meta {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 16rpx;
}
.badge {
  display: inline-block;
  background: #eff6ff;
  color: #2563eb;
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  margin-right: 12rpx;
  margin-bottom: 8rpx;
}
.badge-lv {
  background: #fef3c7;
  color: #b45309;
}
.badge-dim {
  background: #f3f4f6;
  color: #6b7280;
}
.q-text {
  font-size: 34rpx;
  font-weight: 600;
  color: #111827;
  line-height: 1.55;
}
.q-evi {
  font-size: 23rpx;
  color: #047857;
  margin-top: 14rpx;
  line-height: 1.5;
}

/* ---- 折叠区 ---- */
.fold {
  margin-top: 20rpx;
  padding: 14rpx 0;
  border-top: 2rpx solid #f3f4f6;
}
.fold-label {
  font-size: 25rpx;
  color: #2563eb;
}
.fold-body {
  background: #f9fafb;
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  margin-top: 8rpx;
}
.fu {
  display: flex;
  align-items: flex-start;
  margin-bottom: 8rpx;
}
.fu-dot {
  color: #9ca3af;
  margin-right: 10rpx;
  line-height: 1.6;
}
.fu-txt {
  flex: 1;
  font-size: 25rpx;
  color: #374151;
  line-height: 1.6;
}

/* ---- 作答 ---- */
.ans-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}
.ans-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #374151;
}
.ans-timer {
  font-size: 24rpx;
  color: #6b7280;
}
.ans-timer.over {
  color: #dc2626;
  font-weight: 600;
}
.ta {
  width: 100%;
  box-sizing: border-box;
  background: #f9fafb;
  border: 2rpx solid #e5e7eb;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  min-height: 220rpx;
  line-height: 1.65;
}
.ans-count {
  font-size: 22rpx;
  color: #9ca3af;
  text-align: right;
  margin-top: 8rpx;
}

/* ---- 反馈 ---- */
.fb {
  border-left: 8rpx solid #2563eb;
}
.fb-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}
.fb-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #111827;
}
.fb-score {
  font-size: 30rpx;
  font-weight: 700;
  color: #2563eb;
}
.fb-text {
  font-size: 26rpx;
  color: #374151;
  line-height: 1.6;
}
.fb-sec {
  margin-top: 12rpx;
  display: flex;
  align-items: flex-start;
}
.fb-k {
  font-size: 23rpx;
  color: #047857;
  background: #d1fae5;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}
.fb-miss {
  color: #b91c1c;
  background: #fee2e2;
}
.fb-v {
  flex: 1;
  font-size: 24rpx;
  color: #4b5563;
  line-height: 1.6;
}

/* ---- 按钮 ---- */
.btn {
  width: 100%;
}
.btn-hover {
  opacity: 0.8;
}
.btn-sm {
  margin-top: 0;
  font-size: 28rpx;
  line-height: 2.2;
}
.nav-row {
  display: flex;
  margin-top: 16rpx;
}
.nav-row .btn {
  margin-left: 16rpx;
}
.nav-row .btn:first-child {
  margin-left: 0;
}
.hint {
  font-size: 22rpx;
  color: #9ca3af;
  line-height: 1.6;
  margin-top: 12rpx;
}
