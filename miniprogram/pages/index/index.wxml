<view class="container">
  <view class="hero">
    <view class="hero-title">面镜</view>
  </view>

  <!-- 场景选择 -->
  <view class="section-title">选择练习场景</view>
  <view class="scene-grid">
    <view
      wx:for="{{scenes}}"
      wx:key="key"
      class="scene-card {{scene === item.key ? 'active' : ''}}"
      data-key="{{item.key}}"
      bindtap="onSceneTap"
    >
      <view class="scene-icon">{{item.icon}}</view>
      <view class="scene-label">{{item.label}}</view>
      <view class="scene-desc">{{item.desc}}</view>
    </view>
  </view>

  <!-- 模式选择 -->
  <view class="section-title">出题方式</view>
  <view class="mode-list">
    <view
      class="mode-card {{mode === 'quiz' ? 'active' : ''}}"
      data-mode="quiz"
      bindtap="onModeTap"
    >
      <view class="mode-title">题库抽题</view>
      <view class="mode-desc">自选科目（可多选），抽 10~15 题批量作答并统一评分</view>
    </view>
    <view
      class="mode-card {{mode === 'custom' ? 'active' : ''}}"
      data-mode="custom"
      bindtap="onModeTap"
    >
      <view class="mode-title">自定义出题 ✨</view>
      <view class="mode-desc">上传简历/论文，AI 生成针对你的追问</view>
    </view>
  </view>

  <!--
    ⚠️ 这里刻意**不用 disabled="{{navigating}}"**。
    事故记录（2026-10-26）：用 disabled 做防重入，一旦 navigating 卡在 true
    （navigateTo 的 success/fail 都没回调），按钮会永久变灰且点击被吞掉，
    整个首页彻底死掉，只能重启小程序才能恢复。
    现在：disabled 全部交给 JS 侧的锁（onStart 里 if (navigating) return），
    按钮永远可点；navigating 只用于显示"跳转中…"的视觉反馈。
  -->
  <button class="btn-primary start-btn {{navigating ? 'is-busy' : ''}}" bindtap="onStart">
    {{navigating ? '跳转中…' : '开始练习'}}
  </button>

  <!--
    深度面试（简历驱动）：与「单题练习」并列的第二条链路。
    走独立页面 → 独立云函数 → 独立的 6 维能力雷达，不与单题练习的状态混用。
  -->
  <view class="deep-entry" bindtap="onDeep">
    <view class="deep-left">
      <view class="deep-title">深度面试 · 简历驱动</view>
      <view class="deep-desc">上传简历 → 岗位分析 → 15~20 道针对性题目 → 逐题作答 → 6 维能力总结</view>
    </view>
    <view class="deep-arrow">›</view>
  </view>

  <view class="history-link" bindtap="onHistory">查看历史记录 →</view>
</view>
