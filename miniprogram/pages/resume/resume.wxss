/* 深度面试 · 简历页 */

.page {
  padding: 24rpx;
  padding-bottom: 60rpx;
}

.hero {
  padding: 12rpx 8rpx 24rpx;
}
.hero-title {
  font-size: 42rpx;
  font-weight: 700;
  color: #111827;
}
.hero-sub {
  font-size: 24rpx;
  color: #6b7280;
  margin-top: 8rpx;
  line-height: 1.5;
}

/* ---- 步骤条 ---- */
.steps {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  padding: 0 4rpx;
}
.step {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}
.step .dot {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  border-radius: 50%;
  background: #e5e7eb;
  color: #9ca3af;
  font-size: 22rpx;
  font-weight: 600;
}
.step .txt {
  font-size: 22rpx;
  color: #9ca3af;
  margin-left: 8rpx;
}
.step.on .dot {
  background: #2563eb;
  color: #fff;
}
.step.on .txt {
  color: #2563eb;
  font-weight: 600;
}
.step.done .dot {
  background: #a7f3d0;
  color: #047857;
}
.step.done .txt {
  color: #047857;
}
.step-line {
  flex: 1;
  height: 2rpx;
  background: #e5e7eb;
  margin: 0 10rpx;
}

/* ---- 错误条 ---- */
.err {
  display: flex;
  align-items: flex-start;
  background: #fef2f2;
  border: 2rpx solid #fecaca;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
}
.err-icon {
  color: #dc2626;
  font-weight: 700;
  margin-right: 12rpx;
  line-height: 1.5;
}
.err-txt {
  flex: 1;
  font-size: 26rpx;
  color: #991b1b;
  line-height: 1.5;
}

/* ---- 卡片内元素 ---- */
.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #111827;
  margin-bottom: 12rpx;
}
.card-desc {
  font-size: 25rpx;
  color: #6b7280;
  line-height: 1.6;
  margin-bottom: 16rpx;
}
.hint {
  font-size: 22rpx;
  color: #9ca3af;
  line-height: 1.6;
  margin-top: 12rpx;
}
.label {
  font-size: 26rpx;
  color: #374151;
  font-weight: 500;
  margin-bottom: 10rpx;
}
.req {
  color: #dc2626;
}

.input {
  background: #f9fafb;
  border: 2rpx solid #e5e7eb;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  color: #1f2937;
}
.field {
  margin-bottom: 24rpx;
}
.ta {
  width: 100%;
  box-sizing: border-box;
  background: #f9fafb;
  border: 2rpx solid #e5e7eb;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  min-height: 120rpx;
  line-height: 1.6;
}

.btn {
  width: 100%;
  margin-top: 16rpx;
}
.btn-hover {
  opacity: 0.8;
}
.tag-ok {
  background: #d1fae5;
  color: #047857;
}

.warn-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 8rpx;
}
.warn-dot {
  color: #f59e0b;
  margin-right: 10rpx;
}
.warn-txt {
  flex: 1;
  font-size: 24rpx;
  color: #92400e;
  line-height: 1.6;
}

/* ---- 结构化条目 ---- */
.item {
  padding: 18rpx 0;
  border-top: 2rpx solid #f3f4f6;
}
.item:first-of-type {
  border-top: none;
}
.item-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2937;
  line-height: 1.5;
}
.item-sub {
  font-size: 23rpx;
  font-weight: 400;
  color: #6b7280;
  margin-left: 8rpx;
}
.item-desc {
  font-size: 24rpx;
  color: #4b5563;
  line-height: 1.6;
  margin-top: 6rpx;
}

/* ---- 能力标准 ---- */
.comp {
  padding: 18rpx 0;
  border-top: 2rpx solid #f3f4f6;
}
.comp:first-child {
  border-top: none;
}
.comp-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.comp-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2937;
}
.comp-weight {
  font-size: 22rpx;
  color: #2563eb;
  background: #eff6ff;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
}
.comp-focus {
  font-size: 24rpx;
  color: #4b5563;
  line-height: 1.6;
  margin-top: 8rpx;
}
.comp-exp {
  font-size: 23rpx;
  color: #6b7280;
  line-height: 1.6;
  margin-top: 4rpx;
}

/* ---- 题目预览 ---- */
.q-preview {
  display: flex;
  align-items: flex-start;
  padding: 20rpx 0;
  border-top: 2rpx solid #f3f4f6;
}
.q-preview:first-of-type {
  border-top: none;
}
.q-no {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  border-radius: 50%;
  background: #eff6ff;
  color: #2563eb;
  font-size: 22rpx;
  font-weight: 600;
  flex-shrink: 0;
  margin-right: 16rpx;
}
.q-body {
  flex: 1;
}
.q-text {
  font-size: 27rpx;
  color: #1f2937;
  line-height: 1.6;
}
.q-meta {
  font-size: 22rpx;
  color: #9ca3af;
  margin-top: 6rpx;
}
.q-evi {
  font-size: 22rpx;
  color: #047857;
  margin-top: 4rpx;
  line-height: 1.5;
}
