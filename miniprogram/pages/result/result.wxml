<view class="container">
  <view wx:if="{{loading}}" class="loading">加载中…</view>

  <block wx:if="{{report}}">
    <!-- 总分 -->
    <view class="card score-card">
      <view class="score-num">{{report.totalScore}}</view>
      <view class="score-label">综合得分 / 100</view>
      <view class="score-overall">{{report.overall}}</view>
    </view>

    <!-- 雷达图 -->
    <view class="card">
      <view class="card-title">五维能力雷达</view>
      <radar-chart radar="{{report.radar}}" labels="{{radarLabels}}" />
    </view>

    <!-- 各维度分数 -->
    <view class="card">
      <view class="card-title">维度评分</view>
      <view class="dim-row" wx:for="{{dimensionList}}" wx:key="key">
        <view class="dim-label">{{item.label}}</view>
        <view class="dim-bar">
          <view class="dim-fill" style="width: {{report.dimensions[item.key] * 20}}%"></view>
        </view>
        <view class="dim-score">{{report.dimensions[item.key]}}</view>
      </view>
    </view>

    <!-- 表达分析（规则化） -->
    <view class="card">
      <view class="card-title">表达数据分析</view>
      <view class="stat-grid">
        <view class="stat">
          <view class="stat-num">{{report.expression.speedWpm}}</view>
          <view class="stat-label">语速(字/分)</view>
        </view>
        <view class="stat">
          <view class="stat-num">{{report.expression.fillerRate}}%</view>
          <view class="stat-label">填充词密度</view>
        </view>
        <view class="stat">
          <view class="stat-num">{{report.expression.longPauseCount}}</view>
          <view class="stat-label">长停顿次数</view>
        </view>
      </view>
      <view wx:if="{{report.expression.fillerTop3.length}}" class="filler-top">
        口头禅：<text wx:for="{{report.expression.fillerTop3}}" wx:key="*this">{{item}} </text>
      </view>
      <view class="time-split">
        时长分配：开场 {{report.expression.timeSplit.opening}}% · 主体 {{report.expression.timeSplit.body}}% · 结尾 {{report.expression.timeSplit.closing}}%
      </view>
    </view>

    <!-- 优点 -->
    <view class="card" wx:if="{{report.strengths.length}}">
      <view class="card-title">优点</view>
      <view class="strength" wx:for="{{report.strengths}}" wx:key="index">
        <view class="strength-text">{{item.text}}</view>
        <view class="strength-quote">「{{item.quote}}」</view>
      </view>
    </view>

    <!-- 改进建议 -->
    <view class="card" wx:if="{{report.improvements.length}}">
      <view class="card-title">改进建议</view>
      <view class="improvement" wx:for="{{report.improvements}}" wx:key="index">
        {{index + 1}}. {{item}}
      </view>
    </view>

    <!-- 逐句批注 -->
    <view class="card" wx:if="{{report.sentenceNotes.length}}">
      <view class="card-title">逐句批注</view>
      <sentence-note wx:for="{{report.sentenceNotes}}" wx:key="index" note="{{item}}" />
    </view>

    <!-- 示范回答 -->
    <view class="card" wx:if="{{report.modelAnswer}}">
      <view class="card-title">示范回答</view>
      <view class="model-answer">{{report.modelAnswer}}</view>
    </view>

    <!-- 操作 -->
    <view class="action-row">
      <button class="btn-primary" bindtap="onShowPoster">生成分享海报</button>
    </view>
  </block>

  <!-- 分享海报弹层 -->
  <view wx:if="{{showPoster}}" class="poster-mask" bindtap="onHidePoster">
    <view class="poster-modal" catchtap="">
      <share-poster score="{{report.totalScore}}" radar="{{report.radar}}" labels="{{radarLabels}}" />
      <view class="close-btn" bindtap="onHidePoster">关闭</view>
    </view>
  </view>
</view>
