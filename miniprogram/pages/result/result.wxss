.loading {
  text-align: center;
  padding: 100rpx 0;
  color: #9ca3af;
}

/* 加载失败 / 空态（新增） */
.empty {
  text-align: center;
  padding: 80rpx 40rpx;
  color: #6b7280;
  font-size: 28rpx;
}
.empty-icon {
  font-size: 72rpx;
  margin-bottom: 16rpx;
}
.retry-load-btn {
  margin-top: 32rpx;
  width: 320rpx;
  font-size: 28rpx;
  line-height: 2.4;
}

.score-card {
  text-align: center;
  padding: 40rpx;
}
.score-num {
  font-size: 96rpx;
  font-weight: 800;
  color: #2563eb;
  line-height: 1;
}
.score-label {
  font-size: 24rpx;
  color: #6b7280;
  margin-top: 8rpx;
}
.score-overall {
  font-size: 26rpx;
  color: #4b5563;
  margin-top: 16rpx;
  text-align: left;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
  color: #374151;
}

.dim-row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}
.dim-label {
  width: 120rpx;
  font-size: 26rpx;
  color: #4b5563;
}
.dim-bar {
  flex: 1;
  height: 16rpx;
  background: #f1f5f9;
  border-radius: 8rpx;
  overflow: hidden;
}
.dim-fill {
  height: 100%;
  background: linear-gradient(90deg, #2563eb, #7c3aed);
  border-radius: 8rpx;
}
.dim-score {
  width: 60rpx;
  text-align: right;
  font-size: 26rpx;
  font-weight: 600;
  color: #2563eb;
}

.stat-grid {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}
.stat {
  flex: 1;
  background: #f8fafc;
  border-radius: 12rpx;
  padding: 20rpx 0;
  text-align: center;
}
.stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #1f2937;
}
.stat-label {
  font-size: 22rpx;
  color: #6b7280;
  margin-top: 4rpx;
}
.filler-top,
.time-split {
  font-size: 24rpx;
  color: #6b7280;
  margin-top: 12rpx;
}

.strength {
  margin-bottom: 16rpx;
}
.strength-text {
  font-size: 28rpx;
  color: #1f2937;
}
.strength-quote {
  font-size: 24rpx;
  color: #6b7280;
  background: #f8fafc;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  margin-top: 6rpx;
}

.improvement {
  font-size: 26rpx;
  color: #4b5563;
  line-height: 1.8;
}

.model-answer {
  font-size: 26rpx;
  color: #4b5563;
  line-height: 1.8;
  background: #f8fafc;
  padding: 20rpx;
  border-radius: 12rpx;
}

.action-row {
  margin-top: 24rpx;
}
.action-row .btn-primary {
  width: 100%;
}

/* 海报弹层 */
.poster-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
}
.poster-modal {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.close-btn {
  margin-top: 20rpx;
  color: #fff;
  font-size: 28rpx;
}

/* ---- 薄弱项诊断卡（第三轮交互增强） ---- */
.weakness-card {
  border-left: 6rpx solid #f59e0b;
  background: linear-gradient(135deg, #fffbeb 0%, #fff 60%);
}
.weakness-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 16rpx 0 12rpx;
}
.weakness-badge {
  font-size: 26rpx;
  font-weight: 700;
  color: #b45309;
  background: #fef3c7;
  border-radius: 8rpx;
  padding: 6rpx 16rpx;
}
.weakness-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #92400e;
}
.weakness-tip {
  font-size: 26rpx;
  color: #4b5563;
  line-height: 1.7;
  margin-bottom: 18rpx;
}
.weakness-btn {
  background: #f59e0b;
  color: #fff;
  font-size: 26rpx;
  border-radius: 999rpx;
  padding: 0 28rpx;
}

/* ---- 同题重练卡（第四轮交互增强） ---- */
.retry-card {
  border-left: 6rpx solid #2563eb;
  background: linear-gradient(135deg, #eff6ff 0%, #fff 60%);
}
.retry-label {
  font-size: 22rpx;
  color: #64748b;
  margin-bottom: 8rpx;
}
.retry-question {
  font-size: 27rpx;
  color: #1f2937;
  line-height: 1.6;
  margin-bottom: 18rpx;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.retry-btn {
  background: #2563eb;
  color: #fff;
  font-size: 26rpx;
  border-radius: 999rpx;
  padding: 0 28rpx;
}
