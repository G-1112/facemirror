.loading {
  text-align: center;
  padding: 100rpx 0;
  color: #9ca3af;
}

.score-card {
  text-align: center;
  padding: 40rpx;
}
.score-num {
  font-size: 96rpx;
  font-weight: 800;
  color: #2563eb;
  line-height: 1;
}
.score-label {
  font-size: 24rpx;
  color: #6b7280;
  margin-top: 8rpx;
}
.score-overall {
  font-size: 26rpx;
  color: #4b5563;
  margin-top: 16rpx;
  text-align: left;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
  color: #374151;
}

.dim-row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}
.dim-label {
  width: 120rpx;
  font-size: 26rpx;
  color: #4b5563;
}
.dim-bar {
  flex: 1;
  height: 16rpx;
  background: #f1f5f9;
  border-radius: 8rpx;
  overflow: hidden;
}
.dim-fill {
  height: 100%;
  background: linear-gradient(90deg, #2563eb, #7c3aed);
  border-radius: 8rpx;
}
.dim-score {
  width: 60rpx;
  text-align: right;
  font-size: 26rpx;
  font-weight: 600;
  color: #2563eb;
}

.stat-grid {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}
.stat {
  flex: 1;
  background: #f8fafc;
  border-radius: 12rpx;
  padding: 20rpx 0;
  text-align: center;
}
.stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #1f2937;
}
.stat-label {
  font-size: 22rpx;
  color: #6b7280;
  margin-top: 4rpx;
}
.filler-top,
.time-split {
  font-size: 24rpx;
  color: #6b7280;
  margin-top: 12rpx;
}

.strength {
  margin-bottom: 16rpx;
}
.strength-text {
  font-size: 28rpx;
  color: #1f2937;
}
.strength-quote {
  font-size: 24rpx;
  color: #6b7280;
  background: #f8fafc;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  margin-top: 6rpx;
}

.improvement {
  font-size: 26rpx;
  color: #4b5563;
  line-height: 1.8;
}

.model-answer {
  font-size: 26rpx;
  color: #4b5563;
  line-height: 1.8;
  background: #f8fafc;
  padding: 20rpx;
  border-radius: 12rpx;
}

.action-row {
  margin-top: 24rpx;
}
.action-row .btn-primary {
  width: 100%;
}

/* 海报弹层 */
.poster-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
}
.poster-modal {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.close-btn {
  margin-top: 20rpx;
  color: #fff;
  font-size: 28rpx;
}
