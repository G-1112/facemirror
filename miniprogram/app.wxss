/* 全局样式 */
page {
  background: #f5f6f8;
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
  color: #1f2937;
  font-size: 28rpx;
}

.container {
  padding: 24rpx;
}

.card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.btn-primary {
  background: #2563eb;
  color: #ffffff;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 2.6;
  text-align: center;
}
.btn-primary[disabled] {
  background: #cbd5e1;
  color: #ffffff;
}

.btn-ghost {
  background: #ffffff;
  color: #2563eb;
  border: 2rpx solid #2563eb;
  border-radius: 16rpx;
  font-size: 32rpx;
  line-height: 2.5;
  text-align: center;
}

.muted {
  color: #6b7280;
  font-size: 24rpx;
}

.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  margin-right: 12rpx;
}
