{
  "compilerOptions": {
    "strict": true,
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "allowJs": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noImplicitAny": false,
    "noUnusedLocals": false,
    "lib": ["ES2020"],
    "typeRoots": ["./typings", "./node_modules/miniprogram-api-typings"],
    "baseUrl": ".",
    "paths": {
      "*": ["node_modules/*"]
    }
  },
  "include": ["miniprogram/**/*.ts"],
  "exclude": ["node_modules", "cloudfunctions"]
}
